# homepage - one instance per docker host, behind nginx-proxy
# Copy to .env and edit: cp env.example .env
#
# Global configuration

# Optional - defaults to web-proxy. External nginx-proxy network name; it must
# already exist on the host and match the proxy cluster's NGINX_PROXY_NETWORK.
NGINX_PROXY_NETWORK=web-proxy
# Required - root domain this host serves (vhost becomes homepage.<BASE_DOMAIN>).
BASE_DOMAIN=localhost

# --- homepage ---
# Required - pinned homepage version (must match Dockerfile FROM/BASE_IMAGE;
# bump together).
HOMEPAGE_VERSION=v2.4.0
# Optional - defaults to UTC. Container timezone.
TZ=UTC
# Optional - defaults to false. Self-signed TLS opt-in, honoured only by a
# LAN/self-signed proxy variant; leave false for an internet-facing cluster
# (ACME_HOST is used there). Set true for a LAN deployment or local testing.
HOMEPAGE_GEN_SELF_SIGNED_CERT=false
