# homepage - one instance per docker host, behind nginx-proxy
# Copy to .env and edit: cp .env.example .env
#
# Required - compose fails fast when these are missing:
# External nginx-proxy network name (must already exist on the host).
NGINX_PROXY_NETWORK=web-proxy
# Root domain this host serves (vhost becomes homepage.<BASE_DOMAIN>).
BASE_DOMAIN=example.com
# Pinned homepage version (must match Dockerfile FROM/BASE_IMAGE; bump together).
HOMEPAGE_VERSION=v2.4.0

# Optional (defaults to UTC if unset in .env):
# Timezone for the container.
TZ=UTC
